rules_version = '2';

// Racha lee y escribe Firestore solo desde el servidor (Admin SDK, que no pasa por estas reglas).
// El navegador nunca habla con Firestore directo, así que todo acceso de cliente queda cerrado.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
