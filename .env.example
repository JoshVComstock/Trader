# Copia este archivo a .env.local y rellena los valores. Nunca subas valores reales a este archivo.

# Firebase — Consola de Firebase → Configuración del proyecto
FIREBASE_PROJECT_ID=
# Cuentas de servicio → Generar nueva clave privada (JSON): client_email y private_key.
# La clave va en una sola línea, entre comillas, con los saltos como \n.
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
# General → Tus apps → App web → apiKey. La usa el servidor para iniciar sesión con email y contraseña.
FIREBASE_WEB_API_KEY=

# Desarrollo con emuladores (pnpm emulators): descomenta y no hace falta la cuenta de servicio.
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099

# Cloudinary — Dashboard → API Keys. Sin esto la app funciona, pero no se pueden subir capturas.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Usuario de prueba que crea `pnpm seed` (solo desarrollo local)
SEED_EMAIL=
SEED_PASSWORD=

# Solo para `pnpm migrate:supabase` (copiar tus datos de la base vieja una vez)
SUPABASE_URL=
SUPABASE_SECRET_KEY=
