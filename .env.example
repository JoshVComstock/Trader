# Copia este archivo a .env.local y rellena los valores.

# Supabase — Project Settings → API (o la salida de `pnpm exec supabase status` en local)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Solo para el script de seed. Nunca la expongas al navegador ni la subas a Vercel si no hace falta.
SUPABASE_SECRET_KEY=

# Cloudinary — Dashboard → API Keys. Sin esto la app funciona, pero no se pueden subir capturas.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Usuario de prueba que crea `pnpm seed` (solo desarrollo local)
SEED_EMAIL=demo@racha.test
SEED_PASSWORD=racha-demo-2026
